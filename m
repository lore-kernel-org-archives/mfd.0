-	wm8400->regulators[reg].id = reg;
-	wm8400->regulators[reg].dev.parent = dev;
-	wm8400->regulators[reg].dev.platform_data = initdata;
-
-	return platform_device_register(&wm8400->regulators[reg]);
-}
