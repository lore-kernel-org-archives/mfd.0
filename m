-	si476x_core_pronounce_dead(core);
-	mfd_remove_devices(&client->dev);
-
-	if (client->irq)
-		disable_irq(client->irq);
-	else
-		cancel_delayed_work_sync(&core->status_monitor);
-
-	kfifo_free(&core->rds_fifo);
-}
