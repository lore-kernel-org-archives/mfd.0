-	int ret;
-	int uA;
-
-	led->value = value;
-
-	spin_lock_irqsave(&led->value_lock, flags);
-
-	if (led->value == LED_OFF) {
-		spin_unlock_irqrestore(&led->value_lock, flags);
-		return wm8350_led_disable(led);
-	}
