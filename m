-	case WM8350_DCDC_3:
-		reg = WM8350_DCDC3_FORCE_PWM;
-		break;
-	case WM8350_DCDC_4:
-		reg = WM8350_DCDC4_FORCE_PWM;
-		break;
-	case WM8350_DCDC_6:
-		reg = WM8350_DCDC6_FORCE_PWM;
-		break;
-	default:
-		return -EINVAL;
-	}
-
-	if (enable)
-		ret = wm8350_set_bits(wm8350, reg,
-			WM8350_DCDC1_FORCE_PWM_ENA);
-	else
-		ret = wm8350_clear_bits(wm8350, reg,
-			WM8350_DCDC1_FORCE_PWM_ENA);
