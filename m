-	int id = lattr->u.output.id;
-	u8 val;
-	int ret;
-
-	if (kstrtou8(buf, 0, &val))
-		return -EINVAL;
-
-	if (lattr->type == LM3533_ATTR_TYPE_BACKLIGHT)
-		ret = lm3533_set_hvled_config(lm3533, id, val);
-	else
-		ret = lm3533_set_lvled_config(lm3533, id, val);
-
-	if (ret)
-		return ret;
-
-	return len;
-}
