-	int retries = WM8350_SET_ALM_RETRIES;
-	u16 rtc_ctrl;
-	int ret;
-
-	/* Set RTC_SET to stop the clock */
-	ret = wm8350_set_bits(wm8350, WM8350_RTC_TIME_CONTROL,
